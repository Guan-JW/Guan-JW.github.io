---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.locale | escape }}">
  <title>{{ site.title | xml_escape }}</title>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.name | xml_escape }}</name></author>
  {% if site.blog_enabled %}
  {% assign blog_posts = site.blog | where_exp: 'post', 'post.date <= site.time' | sort: 'date' | reverse %}
  {% for post in blog_posts limit:20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.modified | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | markdownify | xml_escape }}</summary>
  </entry>
  {% endfor %}
  {% endif %}
</feed>
